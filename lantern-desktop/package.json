{
  "name": "lantern-desktop",
  "version": "1.0.0",
  "description": "Lantern browser",
  "author": "Lantern",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.lantern",
    "productName": "Lantern",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  }
}